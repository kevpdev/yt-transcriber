#!/bin/sh
# Enable with: git config core.hooksPath scripts/hooks
# Checks the staged content, not the working tree: the index is exported to a throwaway directory.
set -e
TOP=$(git rev-parse --show-toplevel)
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
git checkout-index -a --prefix="$TMP/"
CHECK_ROOT="$TMP" "$TOP/scripts/check.sh" --fast
